    "benchmark:startup": "node ./scripts/benchmark-startup.mjs",
    "test:unit": "node ./scripts/run-tests.mjs",
    "test": "pnpm run build && pnpm run validate && pnpm run test:unit"
  },
  "dependencies": {
    "@x-era/forge-core": "0.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
